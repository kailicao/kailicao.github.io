\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{kccv}[2026/10/12 Single-column CV that automatic parsers can read]
% Readable by applicant-tracking systems and other parsers: one column, standard
% section headings, no tables, icons or text boxes, contact details in the body,
% and a text layer in which every glyph maps to Unicode (copy and paste works).
\ifdefined\pdfgentounicode
  \input{glyphtounicode}
  \pdfgentounicode=1
\fi
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage[default,semibold]{sourcesanspro}   % a clean sans-serif, with real bold and semibold
\RequirePackage[protrusion=true,expansion=true]{microtype}
\RequirePackage[letterpaper,margin=1in]{geometry}
\RequirePackage{amsmath,bm}
\RequirePackage{etoolbox}
\RequirePackage[nobottomtitles*]{titlesec}
% A heading in the bottom 8% of a page moves to the next page, so it always comes with its content.
\renewcommand{\bottomtitlespace}{0.08\textheight}
\RequirePackage{xcolor}
\definecolor{cvblue}{HTML}{1F5AA6}   % links: the website's blue
\definecolor{umblue}{HTML}{00274C}   % headings, name and dates: Michigan Blue
\definecolor{cvrulegray}{HTML}{A9ABAE}  % rules under section headings
\definecolor{cvgray}{HTML}{55565A}   % secondary text
\definecolor{cvrule}{HTML}{B8C4D6}   % section rules
\RequirePackage[colorlinks=true,urlcolor=cvblue,linkcolor=cvblue,pdfencoding=auto]{hyperref}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\linespread{1.06}
% Ragged right with a limited stretch, no hyphenation, and a last line that is not left with a word or two.
\raggedright
\setlength{\rightskip}{0pt plus 0.3\linewidth}
\setlength{\parfillskip}{0pt plus 0.6\linewidth}
\hyphenpenalty=10000
\exhyphenpenalty=10000
\emergencystretch=1em
% Page breaks: no single line of an entry alone at the bottom or top of a page.
\clubpenalty=10000
\widowpenalty=10000
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
% Name and page number on every page (the guidance asks for them from page 2 on;
% the name is also in the body, so parsers that skip footers lose nothing).
\fancyfoot[L]{\small\color{cvgray}Kaili Cao, \cvversionlabel}
\fancyfoot[R]{\small\color{cvgray}Page \thepage}
\providecommand{\cvversionlabel}{Curriculum Vitae}
\titleformat{\section}{\large\bfseries\color{umblue}}{}{0pt}{}[{\color{cvrulegray}\vspace{1pt}\titlerule[0.8pt]}]
\titlespacing*{\section}{0pt}{16pt}{7pt}
\titleformat{\subsection}{\normalsize\bfseries\color{cvgray}}{}{0pt}{}
\titlespacing*{\subsection}{0pt}{9pt}{4pt}
% The name and the line under it.
\newcommand{\cvname}[1]{{\fontsize{24}{28}\selectfont\bfseries\color{umblue}#1}\par\vspace{5pt}}
\newcommand{\cvtagline}[1]{{\color{cvgray}#1}\par\vspace{3pt}}
% Space after each entry (the short version uses a little less).
\newlength{\cvitemsep}
\setlength{\cvitemsep}{4pt}
% Links: the text is shown; \Colorhref keeps the old macro name used in bib-*.tex.
\newcommand\Colorhref[3][]{\href{#2}{#3}}
% Every separation is a real character (a colon or comma), not just white space,
% so that text extraction never runs two items together.
% \cvitem{date or label}{text}: "date: text", the date in bold, with a hanging indent.
\newcommand{\cvitem}[2]{\par\hangindent=1.2em\hangafter=1
  \ifstrempty{#1}{}{{\bfseries\color{umblue}#1}: }#2\par\vspace{\cvitemsep}}
% \cventry{dates}{title}{institution}{city}{country}{description}: "dates: title, institution, city, country".
\newcommand{\cventry}[6]{\par\hangindent=1.2em\hangafter=1
  {\bfseries\color{umblue}#1}: \textbf{#2}\ifstrempty{#3}{}{, #3}\ifstrempty{#4}{}{, #4}\ifstrempty{#5}{}{, #5}\par
  \ifstrempty{#6}{}{\hangindent=1.2em\hangafter=0 {\color{cvgray}#6}\par}\vspace{\cvitemsep}}
